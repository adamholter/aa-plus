{
  "manifest_version": 3,
  "name": "AA Plus",
  "version": "0.4.1",
  "description": "Unofficial: subscription pricing, effort picks, a strengths radar and dark mode on Artificial Analysis, with data from Priors.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mypriors.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aa-plus@mypriors.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://artificialanalysis.ai/*"
      ],
      "js": [
        "shared.page.js",
        "page.js",
        "pareto.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://artificialanalysis.ai/*"
      ],
      "js": [
        "shared.js",
        "chart.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AA Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  }
}
